# Copy to .env and fill in. .env is gitignored; this template is not.
#   cp .env.example .env

# --- Database -----------------------------------------------------------
# Default matches docker-compose.yml, so `docker compose up -d` needs no edit.
# To use a hosted Postgres (Neon, Prisma Postgres, Supabase) instead, replace
# this with its connection string — nothing else changes.
DATABASE_URL="postgresql://tevora:tevora@localhost:5432/tevora_chat?schema=public"

# --- Auth ---------------------------------------------------------------
# Signs the session JWT. Generate your own:
#   openssl rand -base64 32
AUTH_SECRET=""

# Only needed when running a PRODUCTION build somewhere other than Vercel —
# `npm run build && npm start` locally, Docker, Render, Fly, a VM. Auth.js
# refuses to trust the Host header in production unless it can verify the
# origin, and without this every sign-in fails with `UntrustedHost`.
#
# Leave it unset for `npm run dev` and for Vercel: development and the VERCEL
# env var each make Auth.js trust the host on their own.
#
# AUTH_URL="http://localhost:3000"

# --- Anthropic ----------------------------------------------------------
# Server-side only. Never prefixed with NEXT_PUBLIC_ and never sent to the
# browser. Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""
